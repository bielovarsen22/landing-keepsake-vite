    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "pug": "^3.0.3",
    "sass": "^1.80.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite": "^5.4.10",
    "vituum": "^1.1.0"
